# Copy to .env and fill in by hand. Never commit .env.
# On the HF Space, set OPENROUTER_API_KEY as a Space *secret*.

# OpenRouter (set a US$10 credit limit on this key in the OpenRouter dashboard)
OPENROUTER_API_KEY=

# Parse model: chosen by the Phase 2 bake-off 2026-10-16 (see evals/bakeoff/). Fallback = other provider.
PARSE_MODEL=anthropic/claude-haiku-5.5
PARSE_FALLBACK_MODEL=openai/gpt-6-luna

# Demo operations (spec R16, R17)
SESSION_MESSAGE_LIMIT=40
DAILY_LLM_CALL_CAP=2000
RESET_INTERVAL_H=2
DB_PATH=runs/bees.db

# LangSmith tracing (optional). Both must be set; otherwise nothing is sent.
# On the Space: LANGSMITH_API_KEY as a *secret*, LANGSMITH_TRACING as a variable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bees-order-agent
